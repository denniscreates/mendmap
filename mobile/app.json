{
  "expo": {
    "name": "MendMap",
    "slug": "mendmap",
    "scheme": "mendmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070d1f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mendmap"
    },
    "android": {
      "package": "app.mendmap",
      "adaptiveIcon": {
        "backgroundColor": "#0e1f45",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MendMap uses your location to place your report exactly where the problem is."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MendMap uses the camera so you can photograph street problems.",
          "photosPermission": "MendMap lets you attach a photo of the problem from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2f63f0"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070d1f"
        }
      ],
      "expo-localization",
      "expo-audio",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
