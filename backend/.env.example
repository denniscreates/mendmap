# Copy to .env and edit. Load with:  uvicorn app.main:app --env-file .env --host 0.0.0.0
DATABASE_URL=mysql+pymysql://mendmap:change-me@localhost:3306/mendmap?charset=utf8mb4
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@mendmap.local
ADMIN_PASSWORD=change-me
# Prishtina demo data: 19 reports with photos, plus the crew account
SEED_DEMO=1
# Create crew@mendmap.local even without demo data
SEED_CREW=0
# AI: photo check (category, severity, rejects non-street photos) and voice-note transcription.
# Gemini does both; Claude does the photo check. With both keys, Gemini is used (MENDMAP_AI_PROVIDER=auto).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy or slow
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
MENDMAP_AI_PROVIDER=auto
# Set to off to disable the AI check even with a key
MENDMAP_AI=on

# Sign-up codes by email. Without SMTP_HOST the app runs in demo mode and shows the code on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MendMap <no-reply@example.com>
